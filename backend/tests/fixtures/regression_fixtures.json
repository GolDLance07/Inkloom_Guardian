          "content": "guaranteed 100% risk-free",
          "source_label": "Legal Compliance v3",
          "active": true,
          "rule_config": {
            "aliases": ["zero risk guarantee"],
            "replacement": "backed by standard risk management protocols"
          }
        }
      ],
      "draft_text": "Invest with us today and enjoy guaranteed 100% risk-free portfolio yields.",
      "expected_findings": [
        {
          "category": "prohibited_term",
          "severity": "critical",
          "knowledge_item_id": "k-prohib-1",
          "claim_status": "contradicted",
          "matched_phrase": "guaranteed 100% risk-free"
        }
      ],
      "expect_rewrite": true
    },
